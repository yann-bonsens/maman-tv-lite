# EXAMPLE of /etc/maman-tv-lite/api.env.
#
# The real file lives outside this repository so that a password is never
# committed. scripts/install.sh writes it, with these same comments, from the
# answers you give it. This copy is here so the settings are readable without
# a Raspberry Pi in front of you.
#
# Expected permissions: root:root, mode 600. systemd reads it as root before
# applying the service sandbox.

# Maman TV Lite - service configuration.
#
# Read by systemd when maman-api starts, so nothing here takes effect until:
#   sudo systemctl restart maman-api
#
# Keep this file root-owned and mode 600: it holds the API password.

# --- API credentials (HTTP Basic) ------------------------------------------
MAMAN_API_USER=maman
MAMAN_API_PASSWORD=replace-with-a-real-password

# --- Television behaviour ---------------------------------------------------
# Nothing to set here. Which CEC techniques your television obeys is measured,
# never configured by hand: the installation screen asks somebody watching the
# set and writes the answers to /var/lib/maman-tv-lite/tv.json. `GET /tv/config`
# shows what is in force, and `scripts/tv-profile` copies a set of answers
# measured on another television of the same model.


# How much the API says as a whole. INFO by default. Raising this to DEBUG turns
# on every library in the process, paho's MQTT chatter included, on a board whose
# journal is capped at 200 MB — so to record a CEC session, use the setting below
# or the API (PUT /logging/cec) instead of this.
#MAMAN_LOG_LEVEL=INFO

# How much the CEC transport says, on a box that has never been told. INFO keeps
# one line per frame with what became of it; DEBUG adds everything cec-ctl
# printed, which is the cheapest way to record a session — it needs no second
# process on the bus. This is only the starting point: `PUT /logging/cec` changes
# it with no restart and writes it down, and what it wrote wins over this.
#MAMAN_CEC_LOG_LEVEL=INFO

# Path to the CEC adapter. Unset, the box picks the HDMI port the television is
# on (a Pi 4 or 5 has two). Set it only to force one; empty leaves cec-ctl to
# its own default.
#CEC_DEVICE=/dev/cec1

# --- Music and photos (component "media") -----------------------------------

# Where the media live. The installer asks for it and puts the answer in the
# service unit; setting it here wins.
#MAMAN_MEDIA_DIR=/medias

# How long each photo stays on the screen. Longer than on a Pi 5 by default:
# this board needs seconds to decode a photo out of a camera, and the pause
# between two is also what keeps the Zigbee link alive under load.
#MAMAN_PHOTO_SECONDS=15

# Sound output for the music. Empty follows ALSA's own default, which is the
# HDMI output on a box with nothing else plugged in. `aplay -L` lists the
# names. Do NOT reach for mpg123 to list them: given no file to play it
# reads its standard input instead and sits at 100% of this board's only
# core until it is killed.
#MAMAN_AUDIO_DEVICE=

