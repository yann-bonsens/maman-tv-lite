# Installed by maman-tv-lite's scripts/install.sh; scripts/uninstall.sh removes what carries this line.
# Written by scripts/install.sh (component "share"). Re-running it rewrites
# this file; local changes belong in the repository's template.
#
# One share, the media folder, for the Finder (smb://<tailscale address>/medias)
# and the Windows Explorer (\\<tailscale address>\medias).
#
# Kept small on purpose: this board has 512 MB of memory and one core, shared
# with the API, the buttons and Zigbee2MQTT.

[global]
   server string = Maman TV Lite
   server role = standalone server
   # Who may even try. Everyone else is refused before any password is asked:
   # the box may sit on a network shared with strangers (a care home's WiFi),
   # and the share holds a family's photographs.
   #
   # Written by the installer from the answers: loopback and Tailscale's own
   # ranges always, and the local network when it was asked for — which is
   # what a box with no network at all needs, since a Mac plugged straight
   # into it by cable lands on a link-local address (169.254.x.x) and nothing
   # else. By address range rather than by binding to the tailscale0
   # interface, which Samba will not do: it skips point-to-point interfaces.
   hosts allow = __SHARE_ALLOW__
   hosts deny = ALL
   # A password, always: no guest access, no anonymous listing.
   map to guest = never
   restrict anonymous = 2
   # SMB2 and later only: what current macOS and Windows speak, and SMB1 is a
   # known risk. No NetBIOS: names do not cross Tailscale anyway.
   server min protocol = SMB2_10
   disable netbios = yes
   smb ports = 445
   # No printers.
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   logging = systemd
   # The Finder keeps metadata and resource forks as extended attributes, the
   # way Apple's own servers do; without this it litters the share with ._
   # files and some copies fail.
   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

[medias]
   path = __MEDIA_DIR__
   valid users = __MAMAN_USER__
   read only = no
   # Files dropped in stay readable by the service that plays them.
   force group = __MAMAN_USER__
   # The Finder's own litter: ".DS_Store", and "._name" companions that carry
   # a photo's extension and none of its content. Never stored.
   veto files = /._*/.DS_Store/
   delete veto files = yes
   create mask = 0664
   directory mask = 2775
